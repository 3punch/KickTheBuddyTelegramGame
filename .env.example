# ─── Telegram ────────────────────────────────────────────────────────────────
# Get it from @BotFather (https://t.me/BotFather). Leave empty to run the game
# in standalone "web preview" mode (no bot, leaderboard uses a demo player).
BOT_TOKEN=

# Public HTTPS URL of this app (used for the Mini App button + webhook).
# Example: https://kick.example.com
PUBLIC_URL=

# Random secret used to authenticate Telegram webhook calls. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=change-me-please

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0

# SQLite file for leaderboard / players. Created automatically.
DB_PATH=./data/game.db

# Optional: comma separated Telegram user ids that can use admin commands.
ADMIN_IDS=

# Set to "1" to also run getUpdates polling instead of a webhook (local dev,
# no public URL needed).
USE_POLLING=0

# ─── Game tuning (optional overrides, JSON) ──────────────────────────────────
# Default currency granted to first-time players.
START_COINS=250
