{
  "name": "kick-the-professor",
  "version": "1.0.0",
  "private": true,
  "description": "Kick the Professor \u2014 a professional physics-based beat-'em-up Telegram Mini App with swappable character, background and voice packs.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "assets": "node scripts/build-assets.mjs",
    "bot:setup": "node scripts/bot-setup.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "live": "node scripts/live.mjs",
    "live:ngrok": "node scripts/live.mjs --tool ngrok",
    "assets:add": "node scripts/add-asset.mjs",
    "assets:list": "node scripts/add-asset.mjs list"
  },
  "keywords": [
    "telegram",
    "mini-app",
    "game",
    "kick-the-buddy",
    "canvas",
    "ragdoll"
  ],
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "jsdom": "^30.1.3"
  }
}
